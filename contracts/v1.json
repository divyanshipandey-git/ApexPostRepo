  "components": {
    "schemas": {
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "weightKg",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "^APX-(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])$",
            "type": "string",
            "description": "Unique tracking number in format APX-YYYYMMDD (a real calendar date)."
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "type": "number",
            "description": "Package weight in kilograms (0.1 - 70 kg).",
            "format": "double"
          },
          "recipientName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Recipient full name."
          },
          "recipientPhone": {
            "pattern": "^\\+?[1-9]\\d{1,14}$",
            "type": "string",
            "description": "Recipient phone number in E.164 format."
          },
          "recipientAddress": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
            "description": "Recipient street address."
          },
          "recipientCity": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "Recipient city."
          },
          "recipientPostalCode": {
            "maxLength": 20,
            "type": "string",
            "description": "Recipient postal code.",
            "nullable": true
          },
          "recipientCountry": {
            "pattern": "^[A-Z]{2}$",
            "type": "string",
            "description": "Recipient country code (ISO 3166-1 alpha-2).",
            "nullable": true
          },
          "specialInstructions": {
            "maxLength": 500,
            "type": "string",
            "description": "Optional special handling instructions.",
            "nullable": true
          },
          "declaredValue": {
            "maximum": 10000,
            "minimum": 0,
            "type": "number",
            "description": "Optional declared value for insurance.",
            "format": "double",
            "nullable": true
          }
        }
      },
      "GpsCoordinates": {
        "type": "object",
        "properties": {
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number",
            "description": "Latitude in decimal degrees (-90 to 90).",
            "format": "double"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number",
            "description": "Longitude in decimal degrees (-180 to 180).",
            "format": "double"
          }
        }
      },
      "PagedResponseOfShipmentSummary": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentSummary"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ScanDocumentRequest": {
        "required": [
          "scanId",
          "courierId",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "pattern": "^scan::[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string",
            "description": "Unique scan ID from the offline store (format: scan::{Guid})."
          },
          "scanType": {
            "$ref": "#/components/schemas/ScanType"
          },
          "courierId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "Courier ID who performed the scan."
          },
          "location": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
            "description": "Location where scan was performed."
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp when scan was performed."
          },
          "notes": {
            "maxLength": 500,
            "type": "string",
            "description": "Notes about the scan (a Failed scan without a reason is rejected).",
            "nullable": true
          },
          "gpsCoordinates": {
            "$ref": "#/components/schemas/GpsCoordinates",
            "nullable": true
          },
          "recipientSignature": {
            "maxLength": 100,
            "type": "string",
            "description": "Recipient signature name (a Delivered scan without one is rejected).",
            "nullable": true
          }
        }
      },
      "ScanRejectionDetail": {
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "description": "The scan ID that was rejected."
          },
          "reason": {
            "type": "string",
            "description": "The reason for rejection."
          }
        }
      },
      "ScanSummary": {
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string"
          },
          "scanType": {
            "$ref": "#/components/schemas/ScanType"
          },
          "courierId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "gpsCoordinates": {
            "$ref": "#/components/schemas/GpsCoordinates",
            "nullable": true
          },
          "recipientSignature": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ScanType": {
        "enum": [
          "Pickup",
          "InTransit",
          "Delivered",
          "Failed"
        ],
        "type": "string"
      },
      "ScanUploadRequest": {
        "required": [
          "scans"
        ],
        "type": "object",
        "properties": {
          "scans": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanDocumentRequest"
            },
            "description": "List of scan documents to upload."
          }
        }
      },
      "ScanUploadResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "description": "Number of scans successfully accepted and stored.",
            "format": "int32"
          },
          "duplicatesSkipped": {
            "type": "integer",
            "description": "Number of scans skipped because they already existed (idempotent).",
            "format": "int32"
          },
          "duplicateScanIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The scan IDs that were skipped as duplicates. Never listed in rejectionDetails."
          },
          "rejected": {
            "type": "integer",
            "description": "Number of scans rejected with reasons.",
            "format": "int32"
          },
          "rejectionDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRejectionDetail"
            },
            "description": "Details for rejected scans (genuine rejections only, never duplicates)."
          },
          "totalProcessed": {
            "type": "integer",
            "description": "Total scans in the request.",
            "format": "int32",
            "readOnly": true
          }
        }
      },
      "ShipmentDetail": {
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "weightKg": {
            "type": "number",
            "format": "double"
          },
          "recipientName": {
            "type": "string"
          },
          "recipientPhone": {
            "type": "string"
          },
          "recipientAddress": {
            "type": "string"
          },
          "recipientCity": {
            "type": "string"
          },
          "recipientPostalCode": {
            "type": "string",
            "nullable": true
          },
          "recipientCountry": {
            "type": "string",
            "nullable": true
          },
          "specialInstructions": {
            "type": "string",
            "nullable": true
          },
          "declaredValue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "scans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanSummary"
            }
          }
        }
      },
      "ShipmentStatus": {
        "enum": [
          "Created",
          "PickedUp",
          "InTransit",
          "OutForDelivery",
          "Delivered",
          "Failed"
        ],
        "type": "string"
      },
      "ShipmentSummary": {
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "recipientName": {
            "type": "string"
          },
          "recipientCity": {
            "type": "string"
          },
          "weightKg": {
            "type": "number",
            "format": "double"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "lastScanAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "scanCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "UpdateShipmentRequest": {
        "type": "object",
        "properties": {
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "type": "number",
            "format": "double",
            "description": "Package weight in kilograms (0.1 - 70 kg).",
            "nullable": true
          },
          "recipientName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "nullable": true
          },
          "recipientPhone": {
            "pattern": "^\\+?[1-9]\\d{1,14}$",
            "type": "string",
            "nullable": true
          },
          "recipientAddress": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
            "nullable": true
          },
          "recipientCity": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "nullable": true
          },
          "recipientPostalCode": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "recipientCountry": {
            "pattern": "^[A-Z]{2}$",
            "type": "string",
            "nullable": true
          },
          "specialInstructions": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "declaredValue": {
            "maximum": 10000,
            "minimum": 0,
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "reason": {
            "maxLength": 500,
            "type": "string",
            "description": "Reason for the change (required for Delivered and Failed).",
            "nullable": true
          },
          "recipientSignature": {
            "maxLength": 100,
            "type": "string",
            "description": "Recipient signature name (required for Delivered).",
            "nullable": true
          },
          "location": {
            "$ref": "#/components/schemas/GpsCoordinates",
            "nullable": true
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "Partner API key for the read-only partner endpoints.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "Bearer": {
        "type": "http",
        "description": "JWT access token. In Development get one from POST /dev/token.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Shipments"
    },
    {
      "name": "Scans"
    }
  ]
}
