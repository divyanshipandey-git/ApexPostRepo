@model ApexPost.Web.Models.Reports.TopProductsReportViewModel
@{
    ViewData["Title"] = "Top products by region";
}

<section class="page-heading">
    <p class="eyebrow">Auditor report</p>
    <h1>Top products by region</h1>
    <p>Retail revenue includes tax and is ranked per branch region.</p>
</section>

<form method="get" asp-action="TopProducts" class="card surface-card mb-4">
    <div class="card-body d-flex align-items-end gap-3 flex-wrap">
        <div>
            <label for="branchCode" class="form-label">Branch</label>
            <select id="branchCode" name="branchCode" class="form-select">
                <option value="">All branches</option>
                @foreach (var branch in Model.Branches)
                {
                    if (branch.Code == Model.BranchCode) { <option value="@branch.Code" selected>@branch.Code — @branch.Name</option> }
                    else { <option value="@branch.Code">@branch.Code — @branch.Name</option> }
                }
            </select>
        </div>
        <div><label for="fromDate" class="form-label">From (UTC)</label><input id="fromDate" name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label for="toDate" class="form-label">To (UTC)</label><input id="toDate" name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <button type="submit" class="button button-primary">Filter</button>
    </div>
</form>

<section class="card surface-card">
    <div class="card-body">
        <h2 class="section-title">Revenue by regional rank</h2>
        @if (Model.Products.Count == 0)
        {
            <p class="form-hint">No paid retail product sales match the selected filters.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Region</th><th>Rank</th><th>SKU</th><th>Product</th><th>Revenue</th></tr></thead>
                    <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr><th>@product.Region</th><td>@product.RegionRank</td><td>@product.Sku</td><td>@product.ProductName</td><td>@product.Revenue.ToString("C")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
