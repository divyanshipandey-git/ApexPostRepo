@model ApexPost.Web.Models.Reports.ReportsIndexViewModel
@{
    ViewData["Title"] = "Branch reports";
}

<section class="page-heading">
    <p class="eyebrow">Operations and audit</p>
    <h1>Branch reports</h1>
    <p>Reports use saved counter, stock, shipment, and money-order records. Daily activity uses UTC date boundaries.</p>
</section>

<form method="get" asp-action="Index" class="card surface-card mb-4">
    <div class="card-body d-flex align-items-end gap-3 flex-wrap">
        <div><label for="date" class="form-label">Report date (UTC)</label><input id="date" name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div>
            <label for="branchCode" class="form-label">Branch</label>
            <select id="branchCode" name="branchCode" class="form-select">
                @if (Model.BranchScope is null) { <option value="">All branches</option> }
                @foreach (var branch in Model.Branches)
                {
                    if (string.Equals(branch.Code, Model.BranchScope, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@branch.Code" selected>@branch.Code — @branch.Name</option>
                    }
                    else
                    {
                        <option value="@branch.Code">@branch.Code — @branch.Name</option>
                    }
                }
            </select>
        </div>
        <div>
            <label for="threshold" class="form-label">Low-stock threshold</label>
            <input id="threshold" name="threshold" type="number" min="0" max="100000" value="@Model.Threshold" class="form-control" />
        </div>
        <button type="submit" class="button button-primary">Run reports</button>
    </div>
</form>

<section class="card surface-card mb-4"><div class="card-body">
    <h2 class="section-title">Daily sales split</h2>
    @if (Model.DailySales.Count == 0) { <p class="form-hint">No dated paid sales were found for this date.</p> }
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Branch</th><th>Transactions</th><th>Retail</th><th>Services</th><th>Total</th></tr></thead><tbody>
        @foreach (var row in Model.DailySales) { <tr><th>@row.BranchCode</th><td>@row.TransactionCount</td><td>@row.RetailSales.ToString("C")</td><td>@row.ServiceSales.ToString("C")</td><td>@row.TotalSales.ToString("C")</td></tr> }
        </tbody></table></div>
    }
</div></section>

<section class="card surface-card mb-4"><div class="card-body">
    <h2 class="section-title">Low stock</h2>
    @if (Model.LowStock.Count == 0) { <p class="form-hint">No products are at or below reorder level 5.</p> }
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Branch</th><th>SKU</th><th>Product</th><th>On hand</th><th>Reorder level</th></tr></thead><tbody>
        @foreach (var row in Model.LowStock) { <tr><th>@row.BranchCode</th><td>@row.Sku</td><td>@row.ProductName</td><td>@row.QuantityOnHand</td><td>@row.Threshold</td></tr> }
        </tbody></table></div>
    }
</div></section>

<section class="card surface-card mb-4"><div class="card-body">
    <h2 class="section-title">Shipping by zone and service</h2>
    @if (Model.ShippingVolume.Count == 0) { <p class="form-hint">No dated shipments were found for this date.</p> }
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Zone</th><th>Service</th><th>Shipments</th></tr></thead><tbody>
        @foreach (var row in Model.ShippingVolume) { <tr><th>@row.DestinationZone</th><td>@row.ServiceLevel</td><td>@row.ShipmentCount</td></tr> }
        </tbody></table></div>
    }
</div></section>

@if (Model.CanViewAuditorReport)
{
    <section class="card surface-card"><div class="card-body">
        <h2 class="section-title">Money orders and identity checks by branch</h2>
        <p><a asp-action="MoneyOrders">View paginated money order details</a> · <a asp-action="IdentityVerifications">View paginated identity verification details</a> · <a asp-action="TopProducts">Top products by region</a></p>
        @if (Model.ServiceActivity.Count == 0) { <p class="form-hint">No money orders or verification records were found for this date.</p> }
        else
        {
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Branch</th><th>Money orders</th><th>Identity checks</th></tr></thead><tbody>
            @foreach (var row in Model.ServiceActivity) { <tr><th>@row.BranchCode</th><td>@row.MoneyOrderCount</td><td>@row.IdentityVerificationCount</td></tr> }
            </tbody></table></div>
        }
    </div></section>
}
