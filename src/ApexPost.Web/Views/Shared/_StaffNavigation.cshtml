@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var dashboardIsActive = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase);
    var inventoryIsActive = string.Equals(controller, "Inventory", StringComparison.OrdinalIgnoreCase);
    var reportsIsActive = string.Equals(controller, "Reports", StringComparison.OrdinalIgnoreCase);
    var canViewAuditorDetails = User.IsInRole("Auditor") || User.IsInRole("Administrator");
    var transactionsIsActive = string.Equals(controller, "Transactions", StringComparison.OrdinalIgnoreCase);
    var moneyOrdersIsActive = string.Equals(controller, "MoneyOrders", StringComparison.OrdinalIgnoreCase);
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var auditorMoneyOrdersIsActive = reportsIsActive && string.Equals(action, "MoneyOrders", StringComparison.OrdinalIgnoreCase);
    var auditorIdentityIsActive = reportsIsActive && string.Equals(action, "IdentityVerifications", StringComparison.OrdinalIgnoreCase);
    var auditorTopProductsIsActive = reportsIsActive && string.Equals(action, "TopProducts", StringComparison.OrdinalIgnoreCase);
    var newTransactionIsActive = transactionsIsActive && (action is "Create" or "Receipt");
    var canCreateTransactions = User.IsInRole("CounterClerk") || User.IsInRole("BranchManager") || User.IsInRole("Administrator");
    var canManageTransactions = User.IsInRole("BranchManager") || User.IsInRole("Administrator");
    var canViewReports = canManageTransactions || User.IsInRole("Auditor");
    var canManageStock = canManageTransactions;
    var canManageStaff = User.IsInRole("Administrator");
    var productsIsActive = string.Equals(controller, "Products", StringComparison.OrdinalIgnoreCase);
    var stockIsActive = string.Equals(controller, "Stock", StringComparison.OrdinalIgnoreCase);
    var staffIsActive = string.Equals(controller, "Staff", StringComparison.OrdinalIgnoreCase);
    var shippingIsActive = string.Equals(controller, "Shipping", StringComparison.OrdinalIgnoreCase);
    var courierIsActive = string.Equals(controller, "CourierIntegration", StringComparison.OrdinalIgnoreCase);
}

<nav class="nav flex-column primary-navigation" aria-label="Primary navigation" role="navigation">
    <!-- Dashboard -->
    <a asp-controller="Home" asp-action="Index"
       class="nav-link navigation-link @(dashboardIsActive ? "is-active active" : string.Empty)"
       aria-current="@(dashboardIsActive ? "page" : null)"
       title="Dashboard - Daily overview">
        <span class="navigation-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </span>
        <span>Dashboard</span>
    </a>

    <!-- Inventory -->
    <a asp-controller="Inventory" asp-action="Index"
       class="nav-link navigation-link @(inventoryIsActive ? "is-active active" : string.Empty)"
       aria-current="@(inventoryIsActive ? "page" : null)"
       title="Inventory - Stock lookup">
        <span class="navigation-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        </span>
        <span>Inventory</span>
    </a>

    <!-- Products -->
    <a asp-controller="Products" asp-action="Index"
       class="nav-link navigation-link @(productsIsActive ? "is-active active" : string.Empty)"
       aria-current="@(productsIsActive ? "page" : null)"
       title="Product catalogue">
        <span class="navigation-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </span>
        <span>Products</span>
    </a>

    @if (canManageStock)
    {
        <a asp-controller="Stock" asp-action="Index"
           class="nav-link navigation-link @(stockIsActive ? "is-active active" : string.Empty)"
           aria-current="@(stockIsActive ? "page" : null)"
           title="Stock management - Adjust quantities">
            <span class="navigation-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
            <span>Stock</span>
        </a>
    }

    @if (canManageStaff)
    {
        <a asp-controller="Staff" asp-action="Index"
           class="nav-link navigation-link @(staffIsActive ? "is-active active" : string.Empty)"
           aria-current="@(staffIsActive ? "page" : null)"
           title="Staff management">
            <span class="navigation-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span>Staff</span>
        </a>
    }

    @if (canCreateTransactions)
    {
        <a asp-controller="Transactions" asp-action="Create"
           class="nav-link navigation-link @(newTransactionIsActive ? "is-active active" : string.Empty)"
           aria-current="@(newTransactionIsActive ? "page" : null)"
           title="New transaction">
            <span class="navigation-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
            <span>New transaction</span>
        </a>

        <a asp-controller="MoneyOrders" asp-action="Create"
           class="nav-link navigation-link @(moneyOrdersIsActive ? "is-active active" : string.Empty)"
           aria-current="@(moneyOrdersIsActive ? "page" : null)"
           title="Issue money order">
            <span class="navigation-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
            <span>Money orders</span>
        </a>
    }

    @if (canManageTransactions)
    {
        <a asp-controller="Transactions" asp-action="Index"
           class="nav-link navigation-link @(transactionsIsActive ? "is-active active" : string.Empty)"
           aria-current="@(transactionsIsActive ? "page" : null)"
           title="View all transactions">
            <span class="navigation-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </span>
            <span>Transactions</span>
        </a>
    }

    @if (canViewReports)
    {
        <a asp-controller="Reports" asp-action="Index"
           class="nav-link navigation-link @(reportsIsActive ? "is-active active" : string.Empty)"
           aria-current="@(reportsIsActive ? "page" : null)"
           title="Reports and analytics">
            <span class="navigation-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </span>
            <span>Reports</span>
        </a>
    }

    @if (canViewAuditorDetails)
    {
        <div class="navigation-group" style="margin-top: .5rem;">
            <p class="navigation-heading">Auditor tools</p>
            <a asp-controller="Reports" asp-action="MoneyOrders"
               class="nav-link navigation-link @(auditorMoneyOrdersIsActive ? "is-active active" : string.Empty)"
               aria-current="@(auditorMoneyOrdersIsActive ? "page" : null)">
                <span class="navigation-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </span>
                <span>Money order audit</span>
            </a>
            <a asp-controller="Reports" asp-action="IdentityVerifications"
               class="nav-link navigation-link @(auditorIdentityIsActive ? "is-active active" : string.Empty)"
               aria-current="@(auditorIdentityIsActive ? "page" : null)">
                <span class="navigation-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </span>
                <span>Identity audit</span>
            </a>
            <a asp-controller="Reports" asp-action="TopProducts"
               class="nav-link navigation-link @(auditorTopProductsIsActive ? "is-active active" : string.Empty)"
               aria-current="@(auditorTopProductsIsActive ? "page" : null)">
                <span class="navigation-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/><line x1="17" y1="20" x2="7" y2="20"/></svg>
                </span>
                <span>Top products</span>
            </a>
        </div>
    }
</nav>