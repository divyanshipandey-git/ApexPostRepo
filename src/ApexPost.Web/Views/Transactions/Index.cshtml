@model IReadOnlyList<ApexPost.Web.Models.Transactions.TransactionSummaryViewModel>
@{
    ViewData["Title"] = "Counter transactions";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Branch operations</p>
        <h1>Counter transactions</h1>
        <p>Review transactions recorded for your assigned branch.</p>
    </div>
    <span class="badge badge-info">Auto-refresh: manual</span>
</section>

<section class="card surface-card" aria-labelledby="transactions-heading">
    <div class="card-header">
        <h2 id="transactions-heading" class="section-title mb-0">All transactions</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state" role="status" style="padding: 3rem;">
                <div class="empty-state-icon" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
                <p class="empty-state-title">No transactions yet</p>
                <p class="empty-state-text">Transactions will appear here once sales are recorded for this branch.</p>
                <div class="mt-3">
                    <a asp-controller="Transactions" asp-action="Create" class="button button-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Create first transaction
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" aria-describedby="transactions-desc">
                    <caption id="transactions-desc" class="visually-hidden">Transactions for the assigned branch showing transaction ID, status, total, and action</caption>
                    <thead>
                        <tr>
                            <th scope="col">Transaction</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col"><span class="visually-hidden">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model)
                        {
                            var statusClass = transaction.Status switch
                            {
                                "Paid" => "badge-success",
                                "Voided" => "badge-danger",
                                "Refunded" => "badge-warning",
                                _ => "badge-secondary"
                            };
                            <tr>
                                <th scope="row"><code>@transaction.TransactionId</code></th>
                                <td>
                                    <span class="badge @statusClass">
                                        @transaction.Status
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">@transaction.Total.ToString("C")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@transaction.TransactionId" class="button button-secondary button-sm" aria-label="View details for @transaction.TransactionId">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>