@model ApexPost.Web.Models.Inventory.InventoryInquiryViewModel
@{
    ViewData["Title"] = "Inventory";
}

<section class="page-heading" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">Stock management</p>
        <h1 id="page-title">Inventory inquiry</h1>
        <p class="page-description">Check available stock at your branch by entering a branch code and product SKU.</p>
    </div>
    <span class="badge badge-primary page-badge"><span class="status-dot" aria-hidden="true"></span> Stock lookup</span>
</section>

<section class="content-section" aria-labelledby="search-heading">
    <div class="section-heading">
        <h2 id="search-heading">Find an item</h2>
        <p>Enter the branch and SKU exactly as shown in the product catalogue.</p>
    </div>
    <form asp-controller="Inventory" asp-action="Search" method="post" class="card surface-card inquiry-form" novalidate>
        <div asp-validation-summary="All" class="validation-summary" role="alert" aria-live="polite"></div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="notice notice-error" role="alert">
                <span class="notice-icon" aria-hidden="true">!</span>
                <p>@Model.Message</p>
            </div>
        }

        <div class="form-grid">
            <div class="form-field">
                <label asp-for="BranchCode" class="form-label">Branch code <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="BranchCode" class="form-control text-input" autocomplete="off" placeholder="e.g. IND01" required aria-describedby="branch-hint" />
                <span id="branch-hint" class="form-hint">Format: 3-5 characters (e.g., IND01)</span>
                <span asp-validation-for="BranchCode" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Sku" class="form-label">Product SKU <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Sku" class="form-control text-input" autocomplete="off" placeholder="e.g. ENV001" required aria-describedby="sku-hint" />
                <span id="sku-hint" class="form-hint">Format: 4-8 characters (e.g., ENV001)</span>
                <span asp-validation-for="Sku" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="button button-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                Check stock
            </button>
        </div>
    </form>
</section>

@if (Model.Result is not null)
{
    <section class="content-section result-section" aria-labelledby="inventory-result-heading" aria-live="polite">
        <div class="section-heading result-heading">
            <div>
                <p class="eyebrow">Inquiry complete</p>
                <h2 id="inventory-result-heading">Stock result</h2>
            </div>
            <span class="badge badge-success availability-pill"><span class="status-dot" aria-hidden="true"></span> Record found</span>
        </div>
        <div class="card surface-card result-card">
            <dl class="result-grid">
                <div class="result-item">
                    <dt>Branch</dt>
                    <dd>@Model.Result.BranchName <span class="secondary-value">(@Model.Result.BranchCode)</span></dd>
                </div>
                <div class="result-item">
                    <dt>Product</dt>
                    <dd>@Model.Result.ProductName <span class="secondary-value">(@Model.Result.Sku)</span></dd>
                </div>
                <div class="result-item quantity-result">
                    <dt>Quantity on hand</dt>
                    <dd>
                        @if (Model.Result.Quantity == 0)
                        {
                            <span class="text-danger fw-bold">@Model.Result.Quantity</span>
                        }
                        else if (Model.Result.Quantity <= 5)
                        {
                            <span class="text-warning fw-semibold">@Model.Result.Quantity</span>
                        }
                        else
                        {
                            <span>@Model.Result.Quantity</span>
                        }
                    </dd>
                </div>
            </dl>
            @if (Model.Result.Quantity <= 5)
            {
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-controller="Stock" asp-action="Index" asp-route-branchCode="@Model.Result.BranchCode" asp-route-sku="@Model.Result.Sku" class="button button-secondary button-sm">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Adjust stock
                    </a>
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form[asp-action="Search"]');
            const branchInput = document.querySelector('[asp-for="BranchCode"]');
            const skuInput = document.querySelector('[asp-for="Sku"]');

            // Auto-format inputs
            [branchInput, skuInput].forEach(input => {
                if (input) {
                    input.addEventListener('input', function () {
                        this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                    });
                }
            });

            // Enter key submission
            form.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && e.target.tagName !== 'BUTTON') {
                    e.preventDefault();
                    form.dispatchEvent(new Event('submit'));
                }
            });
        });
    </script>
}