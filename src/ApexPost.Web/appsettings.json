{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Maintenance": {
    "Enabled": false,
    "RetryAfterSeconds": 3600
  },
  "Shipping": {
    "MaximumWeightKg": 30,
    "PricingRules": [
      { "DestinationZone": "ZONE1", "ServiceLevel": "Standard", "PricePerKilogram": 20, "BasePrice": 40 },
      { "DestinationZone": "ZONE1", "ServiceLevel": "Express", "PricePerKilogram": 30, "BasePrice": 80 },
      { "DestinationZone": "ZONE1", "ServiceLevel": "Registered", "PricePerKilogram": 25, "BasePrice": 65 }
    ]
  },
  "Tax": {
    "Rates": [
      { "Category": "Standard", "Rate": 0.18 },
      { "Category": "Reduced", "Rate": 0.05 },
      { "Category": "ZeroRated", "Rate": 0 },
      { "Category": "Exempt", "Rate": 0 }
    ]
  }
}
